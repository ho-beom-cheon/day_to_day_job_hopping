{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "failureReason",
    "questions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "FAILED"
      ]
    },
    "failureReason": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "objectiveIds",
          "difficulty",
          "seconds",
          "prompt",
          "choices",
          "answer",
          "modelAnswer",
          "explanation",
          "wrongAnswerExplanations",
          "maxPoints",
          "criteria",
          "sourceEvidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "MCQ",
              "SHORT_ANSWER",
              "INTERVIEW"
            ]
          },
          "objectiveIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "integer"
          },
          "seconds": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer"
          },
          "modelAnswer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "wrongAnswerExplanations": {
            "type": "array",
            "maxItems": 3,
            "description": "MCQ는 정답 선택지를 제외한 오답 3개만 선택지 번호순으로 설명한다. 정답 해설을 포함해 4개를 넣지 않는다. 서술형은 빈 배열이다.",
            "items": {
              "type": "string"
            }
          },
          "maxPoints": {
            "type": "integer"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "points",
                "acceptableAlternatives"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "points": {
                  "type": "integer"
                },
                "acceptableAlternatives": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "sourceEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "objectiveId",
                "sourceId",
                "version",
                "excerpt"
              ],
              "properties": {
                "objectiveId": {
                  "type": "string"
                },
                "sourceId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
