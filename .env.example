# Set a local value; never commit the populated .env file.
DATABASE_PASSWORD=
DATABASE_NAME=daily_career
DATABASE_USER=daily_career
COMPOSE_PROJECT_NAME=daily-career-dev
DB_VOLUME_NAME=daily-career-dev-postgres
# Add dev-seed only for the approved local curriculum/problem/exam catalog.
APP_PROFILES=dev
APP_DOMAIN=localhost
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# This template is local HTTP development. HTTPS production must set true.
SESSION_COOKIE_SECURE=false
# Register APP_ORIGIN/login/oauth2/code/google as Google's authorized redirect URI.
# All three Google fields are required to enable login. Keep values in ignored .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
APP_ORIGIN=http://localhost:8080
# Exact hostname terminated by a local HTTPS proxy; no scheme, port or wildcards. Keep HTTP_BIND_ADDRESS=127.0.0.1.
APP_HTTPS_HOST=
# Local dev profile only. Set both values to temporarily skip Google login for UI testing.
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=
# Optional server-side AI gateway. Keep the key only in ignored .env.
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
# Use openai for direct OpenAI Responses API access. Keep this project key in ignored .env only.
AI_PROVIDER_TYPE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional external delivery settings. Store actual secrets only in ignored .env.
WEB_PUSH_PUBLIC_KEY=
# VAPID P-256 private scalar and a separate 32-byte AES key, both Base64url without padding.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBSCRIPTION_KEY=
WEB_PUSH_KEY_ID=
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Comma-separated exact hosts or suffixes beginning with a dot. Empty uses the built-in provider allowlist.
WEB_PUSH_ALLOWED_HOSTS=
SLACK_CREDENTIAL_REF=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_NAME=
SLACK_ALLOWED_HOSTS=hooks.slack.com,hooks.slack-gov.com
# Optional public Notion OAuth connection. Register the exact callback below in Notion.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/notion/callback
# Separate 32-byte Base64url AES key. Generate locally and never commit the populated value.
NOTION_CREDENTIAL_KEY=
NOTION_KEY_ID=notion-local-v1

# Browser connection setup (operator guide: docs/integration-operator-setup.md)
# 32 random bytes encoded as Base64; persist securely across restarts/backups.
INTEGRATION_CREDENTIAL_KEY=
# Slack requires an HTTPS callback on the SAME origin used to sign in.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# OpenRouter needs no client registration. Pick an available JSON-capable model.
OPENROUTER_REDIRECT_URI=http://localhost:8080/api/v1/integrations/browser/openrouter/callback
OPENROUTER_MODEL=
