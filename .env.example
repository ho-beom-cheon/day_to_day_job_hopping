# Set a local value; never commit the populated .env file.
DATABASE_PASSWORD=
DATABASE_NAME=daily_career
DATABASE_USER=daily_career
COMPOSE_PROJECT_NAME=daily-career-dev
DB_VOLUME_NAME=daily-career-dev-postgres
APP_PROFILES=dev
APP_DOMAIN=localhost
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# This template is local HTTP development. HTTPS production must set true.
SESSION_COOKIE_SECURE=false
# OIDC wiring awaits canonical redirect/CSRF/logout contracts (GAP-001).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
